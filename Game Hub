/* =========================================
   MUSIC
   ========================================= */

async function toggleMusic(){

const music=
document.getElementById("music");

const button=
document.getElementById("musicButton");


try{

if(music.paused){

await music.play();

musicStarted=true;

button.textContent="🔊";

button.classList.add(
"playing"
);

}else{

music.pause();

button.textContent="🔇";

button.classList.remove(
"playing"
);

}

}catch(e){

console.log(e);

}

}


/*
Автоматический запуск после
первого взаимодействия.

Браузер может запретить autoplay,
поэтому ошибка намеренно игнорируется.
*/

document.addEventListener(
"click",
function(){

if(musicStarted)
return;


const app=
document.getElementById("app");


if(app.classList.contains("hidden"))
return;


const music=
document.getElementById("music");


music.play()
.then(()=>{

musicStarted=true;

const button=
document.getElementById(
"musicButton"
);

button.textContent="🔊";

button.classList.add(
"playing"
);

})
.catch(()=>{});

},
{once:true}
);


/* =========================================
   LOGOUT
   ========================================= */

function logout(){

localStorage.removeItem(
"brp_access_token"
);

localStorage.removeItem(
"brp_refresh_token"
);

currentAuthUser=null;
currentProfile=null;

const music=
document.getElementById("music");

music.pause();

musicStarted=false;

document
.getElementById("musicButton")
.textContent="🔇";

document
.getElementById("musicButton")
.classList
.remove("playing");


document
.getElementById("password")
.value="";

showAuth();

}


/* =========================================
   ERROR
   ========================================= */

function cleanError(t){

if(!t)
return"Неизвестная ошибка";


if(
t.includes(
"Invalid login credentials"
)
)
return"Неверный логин или пароль.";


if(
t.includes(
"Email not confirmed"
)
)
return"Почта ещё не подтверждена.";


if(
t.includes(
"Invalid API key"
)
)
return"Ошибка подключения к серверу.";


return t
.replace(/[{}\[\]"]/g,"")
.substring(0,220);

}


/* =========================================
   AUTO LOGIN
   ========================================= */

document.addEventListener(
"DOMContentLoaded",
async()=>{

const token=
localStorage.getItem(
"brp_access_token"
);


if(!token){

showAuth();

return;

}


try{

currentAuthUser=
await supabaseFetch(
"/auth/v1/user",
{
headers:{
apikey:SUPABASE_KEY,
Authorization:
"Bearer "+token
}
}
);


await loadProfile();

showApp();


}catch(e){

console.log(
"Сессия отсутствует или устарела."
);

localStorage.removeItem(
"brp_access_token"
);

localStorage.removeItem(
"brp_refresh_token"
);

showAuth();

}

});


