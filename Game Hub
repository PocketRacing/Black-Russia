<script>

/* =========================================
   KARTAVIY GAME HUB
   ========================================= */


/* SUPABASE */

const SUPABASE_URL=
"https://qzswnoeglovfpgrzpnio.supabase.co";

const SUPABASE_KEY=
"sb_publishable_k_MSqLmEL-OMvM5x7slx7w_EqR0HXqY";


/*
ВАЖНО:

Здесь указан путь к первой игре.

Если BLACK RUSSIA находится в папке:

black-russia/index.html

оставляем как есть.

Если ты положишь страницу Black Russia
в другое место, меняется только эта строка.
*/

const BLACK_RUSSIA_URL=
"black-russia/index.html";


let currentAuthUser=null;
let currentProfile=null;
let musicStarted=false;


/* SUPABASE FETCH */

async function supabaseFetch(path,options={}){

const token=
localStorage.getItem("brp_access_token")||
SUPABASE_KEY;

const r=
await fetch(
SUPABASE_URL+path,
{
...options,

headers:{
apikey:SUPABASE_KEY,
Authorization:"Bearer "+token,
"Content-Type":"application/json",
...(options.headers||{})
}

}
);

const text=
await r.text();

let data=null;

try{

data=
text
?JSON.parse(text)
:null;

}catch(e){

data=text;

}

if(!r.ok){

throw new Error(
typeof data==="string"
?data
:JSON.stringify(data)
);

}

return data;

}


/* MESSAGE */

function message(text,color="#ff4b55"){

const e=
document.getElementById("message");

e.textContent=text;
e.style.color=color;

}


/* LOGIN */

async function login(){

const username=
document
.getElementById("username")
.value
.trim();

const password=
document
.getElementById("password")
.value;


if(!username||!password){

message(
"Введите логин и пароль."
);

return;

}


message(
"Подключение к игровому аккаунту...",
"#aaa"
);


try{

/*
Получаем email существующего
аккаунта BLACK RUSSIA по логину.
*/

const r=
await supabaseFetch(
"/rest/v1/rpc/get_login_email",
{
method:"POST",

body:JSON.stringify({
p_username:username
})

}
);


if(!r){

message(
"Аккаунт не найден."
);

return;

}


const email=
typeof r==="string"
?r
:r.email;


/* AUTH */

const auth=
await supabaseFetch(
"/auth/v1/token?grant_type=password",
{
method:"POST",

body:JSON.stringify({
email:email,
password:password
})

}
);


if(!auth?.access_token){

message(
"Не удалось выполнить вход."
);

return;

}


/*
Сохраняем ТОТ ЖЕ токен,
