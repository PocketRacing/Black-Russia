/* REFUEL */

function refuelCar(id){

const cars=
getOwnedCars();

const car=
cars.find(x=>x.id===id);

if(!car)
return;

if(car.fuel>=100)
return toast(
"⛽ Бак уже полный."
);

car.fuel=100;

saveOwnedCars(cars);

renderGarage();

toast(
"⛽ Автомобиль заправлен."
);

}


/* REPAIR */

function repairCar(id){

const cars=
getOwnedCars();

const car=
cars.find(x=>x.id===id);

if(!car)
return;

if(car.condition>=100)
return toast(
"🔧 Автомобиль уже исправен."
);

car.condition=100;

saveOwnedCars(cars);

renderGarage();

toast(
"🔧 Автомобиль отремонтирован."
);

}


/* DRIVE */

function driveCar(id){

const cars=
getOwnedCars();

const car=
cars.find(x=>x.id===id);

if(!car)
return;

if(car.fuel<=0)
return toast(
"⛽ Нет топлива."
);

if(car.condition<=0)
return toast(
"🔧 Сначала отремонтируй автомобиль."
);

car.fuel=
Math.max(
0,
Number(car.fuel)-5
);

saveOwnedCars(cars);

renderGarage();

toast(
"🚗 "+car.shortName+
" выехала в город!"
);

}


