/* BUY CAR */

function buyCar(id){

if(!currentUser)
return toast("❌ Авторизуйся.");

const car=
carsCatalog.find(
x=>x.id===id
);

if(!car)
return toast(
"❌ Автомобиль не найден."
);

const owned=
getOwnedCars();

if(
owned.some(
x=>x.id===car.id
)
)
return toast(
"🚗 Эта машина уже в гараже."
);

const balance=
Number(currentUser.cash||0);

if(balance<car.price){

openModal(
"Недостаточно денег",
"Для покупки "+car.name+
" нужно ₽ "+
number(car.price)+
".\n\nТвой баланс: ₽ "+
number(balance)+"."
);

return;

}


/*
Списываем деньги локально,
добавляем автомобиль в гараж.
*/

currentUser.cash=
balance-car.price;


/*
Сохраняем обновлённый баланс
для текущей сессии.
*/

try{

localStorage.setItem(
"brp_local_cash_"+currentAuthUser.id,
String(currentUser.cash)
);

}catch(e){}


/*
Добавляем автомобиль.
*/

owned.push({

id:car.id,

name:car.name,

shortName:car.shortName,

image:car.image,

fuel:car.fuel,

condition:car.condition,

speed:car.speed,

power:car.power,

boughtAt:new Date().toISOString()

});

saveOwnedCars(owned);


/*
Обновляем интерфейс.
*/

renderAll();

renderCars();

toast(
"🚗 "+car.name+
" куплен и добавлен в гараж!"
);

}


