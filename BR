<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>BLACK RUSSIA RP</title>

<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}

:root{
--bg:#070707;
--panel:#111;
--panel2:#181818;
--line:#292929;
--red:#e50914;
--red2:#ff2633;
--white:#f5f5f5;
--muted:#888;
--green:#31d47a;
--gold:#ffc928
}

body{
font-family:Arial,Helvetica,sans-serif;
background:#050505;
color:var(--white);
min-height:100vh
}

button,input{font-family:inherit}
button{border:0;cursor:pointer}
.hidden{display:none!important}

/* AUTH */

#authScreen{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
background:
radial-gradient(circle at 50% 0%,rgba(229,9,20,.18),transparent 38%),
#050505
}

.auth-box{
width:100%;
max-width:430px;
padding:25px;
background:#101010;
border:1px solid var(--line);
border-radius:16px;
box-shadow:0 20px 60px #000a
}

.logo-box{
width:82px;
height:82px;
margin:0 auto 14px;
display:flex;
align-items:center;
justify-content:center;
border-radius:12px;
background:#080808;
border:2px solid var(--red)
}

.logo-box div{text-align:center;line-height:.85}
.logo-box .b{font-size:27px;font-weight:1000}
.logo-box .r{font-size:17px;font-weight:1000;color:var(--red)}

.logo{
text-align:center;
font-size:28px;
font-weight:1000
}

.logo span,
.top-logo span{
color:var(--red)
}

.logo-sub{
text-align:center;
color:#777;
font-size:10px;
margin:6px 0 23px;
letter-spacing:2px;
text-transform:uppercase
}

.auth-tabs{
display:flex;
gap:5px;
padding:4px;
background:#080808;
border:1px solid #222;
border-radius:10px;
margin-bottom:21px
}

.auth-tab{
flex:1;
padding:11px;
border-radius:7px;
background:transparent;
color:#777;
font-weight:800
}

.auth-tab.active{
background:var(--red);
color:#fff
}

.auth-title{
font-size:22px;
font-weight:900;
margin-bottom:6px
}

.auth-desc{
color:#858585;
font-size:12px;
line-height:1.5;
margin-bottom:18px
}

.field{margin-bottom:13px}

.field label{
display:block;
color:#aaa;
font-size:10px;
font-weight:bold;
margin-bottom:7px
}

.field input{
width:100%;
padding:14px;
color:#fff;
background:#080808;
border:1px solid #2a2a2a;
border-radius:9px;
outline:none
}

.field input:focus{
border-color:var(--red)
}

.primary-btn,
.secondary-btn{
width:100%;
color:#fff;
border-radius:9px;
font-weight:900
}

.primary-btn{
padding:14px;
background:linear-gradient(135deg,#c70711,#f01925)
}

.secondary-btn{
padding:13px;
background:#202020;
border:1px solid #303030;
margin-top:9px
}

.auth-message{
min-height:20px;
margin-top:12px;
text-align:center;
font-size:12px
}

/* APP */

#app{
min-height:100vh;
padding-bottom:76px
}

.topbar{
height:62px;
position:sticky;
top:0;
z-index:50;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 13px;
background:#080808f5;
border-bottom:1px solid #252525;
backdrop-filter:blur(12px)
}

.top-logo{
font-size:16px;
font-weight:1000
}

.server-status{
display:flex;
align-items:center;
gap:6px;
color:#888;
font-size:10px
}

.online-dot{
width:7px;
height:7px;
border-radius:50%;
background:var(--green);
box-shadow:0 0 8px var(--green)
}

.money-box{
display:flex;
gap:5px
}

.money{
padding:6px 8px;
background:#151515;
border:1px solid #292929;
border-radius:7px;
font-size:9px;
font-weight:bold
}

.cash{color:#53dd8a}
.donate{color:var(--red2)}

.page{
display:none;
max-width:1000px;
margin:auto;
padding:15px
}

.page.active{
display:block
}

.page-title{
font-size:25px;
font-weight:1000
}

.page-subtitle{
color:#777;
font-size:11px;
margin:4px 0 17px
}

.section-title{
margin:21px 0 11px;
font-size:16px;
font-weight:900
}

/* HOME */

.hero{
position:relative;
overflow:hidden;
padding:20px;
background:
linear-gradient(120deg,rgba(229,9,20,.16),transparent 55%),
#111;
border:1px solid var(--line);
border-radius:14px
}

.hero:after{
content:"RP";
position:absolute;
right:-10px;
bottom:-35px;
color:#ffffff04;
font-size:120px;
font-weight:1000
}

.hero-small{
color:#777;
font-size:10px;
text-transform:uppercase;
letter-spacing:1.3px
}

.hero-name{
position:relative;
z-index:1;
margin:6px 0 10px;
font-size:27px;
font-weight:1000
}

.hero-name span{
color:var(--red)
}

.stats-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:9px;
margin-top:12px
}

.stat-card{
padding:14px;
background:#111;
border:1px solid #272727;
border-radius:11px
}

.stat-label{
color:#777;
font-size:9px;
margin-bottom:6px
}

.stat-value{
font-size:17px;
font-weight:900
}

.progress{
height:5px;
overflow:hidden;
background:#292929;
border-radius:20px;
margin-top:9px
}

.progress div{
width:0;
height:100%;
background:linear-gradient(90deg,#b90912,#ff2835)
}

.quick-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:8px
}

.quick{
padding:14px 6px;
color:#fff;
background:#111;
border:1px solid #272727;
border-radius:11px
}

.quick-icon{
font-size:22px;
margin-bottom:6px
}

.quick-name{
font-size:10px;
font-weight:bold
}

/* CARDS */

.cards{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px
}

.card{
padding:15px;
background:#111;
border:1px solid #292929;
border-radius:12px
}

.card-title{
font-size:15px;
font-weight:900
}

.card-desc{
color:#777;
font-size:11px;
line-height:1.45;
margin:7px 0 12px
}

/* GARAGE */

.car{
margin-bottom:10px;
overflow:hidden;
background:#111;
border:1px solid #292929;
border-radius:13px
}

.car-image{
height:180px;
display:flex;
align-items:center;
justify-content:center;
background:
radial-gradient(circle,#353535,#161616 50%,#0b0b0b);
overflow:hidden
}

.car-image img{
width:100%;
height:100%;
object-fit:contain
}

.car-body{
padding:14px
}

.car-name{
font-size:17px;
font-weight:900
}

.car-meta{
color:#777;
font-size:10px;
margin-top:5px
}

.car-buttons{
display:flex;
gap:6px;
margin-top:11px
}

.car-buttons button{
flex:1;
padding:9px;
color:#fff;
background:#202020;
border-radius:7px;
font-size:10px;
font-weight:bold
}

/* CAR DEALERSHIP */

.cars-banner{
padding:22px;
margin-bottom:13px;
background:
radial-gradient(circle at 90% 10%,rgba(229,9,20,.2),transparent 45%),
#111;
border:1px solid #292929;
border-radius:14px
}

.cars-banner-title{
font-size:26px;
font-weight:1000
}

.cars-banner-title span{
color:var(--red)
}

.cars-banner-text{
margin-top:6px;
color:#777;
font-size:11px;
line-height:1.5
}

.cars-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px
}

.dealer-card{
overflow:hidden;
background:#111;
border:1px solid #292929;
border-radius:13px
}

.dealer-image{
height:190px;
display:flex;
align-items:center;
justify-content:center;
background:
radial-gradient(circle,#383838,#171717 52%,#090909)
}

.dealer-image img{
width:100%;
height:100%;
object-fit:contain
}

.dealer-body{
padding:14px
}

.dealer-name{
font-size:17px;
font-weight:1000
}

.dealer-desc{
color:#777;
font-size:10px;
line-height:1.45;
margin-top:5px;
min-height:29px
}

.dealer-stats{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:6px;
margin-top:10px
}

.dealer-stat{
padding:7px;
background:#181818;
border-radius:7px
}

.dealer-stat-label{
color:#666;
font-size:8px
}

.dealer-stat-value{
margin-top:3px;
font-size:10px;
font-weight:900
}

.dealer-price{
margin:13px 0 9px;
color:#55dc89;
font-size:14px;
font-weight:1000
}

.dealer-price span{
color:#777;
font-size:9px;
font-weight:normal
}

.buy-car{
width:100%;
padding:11px;
background:var(--red);
color:#fff;
border-radius:8px;
font-size:10px;
font-weight:1000
}

.buy-car.owned{
background:#202020;
color:#777;
border:1px solid #303030
}

/* SHOP */

.shop-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:9px
}

.item{
text-align:center;
padding:15px;
background:#111;
border:1px solid #292929;
border-radius:12px
}

.item-icon{
font-size:34px
}

.item-name{
margin-top:7px;
font-size:12px;
font-weight:900
}

.item-price{
color:#55dc89;
font-size:11px;
margin:7px 0
}

.buy{
width:100%;
padding:9px;
background:var(--red);
color:#fff;
border-radius:7px;
font-size:10px;
font-weight:900
}

/* MAP */

.map{
height:430px;
position:relative;
overflow:hidden;
border:1px solid #292929;
border-radius:14px;
background:
linear-gradient(30deg,transparent 48%,#292929 49%,#292929 51%,transparent 52%),
linear-gradient(-30deg,transparent 48%,#292929 49%,#292929 51%,transparent 52%),
#111;
background-size:90px 90px
}

.map-road{
position:absolute;
background:#363636;
border:2px solid #484848
}

.road1{
width:130%;
height:34px;
left:-10%;
top:43%;
transform:rotate(-12deg)
}

.road2{
width:34px;
height:130%;
left:47%;
top:-10%;
transform:rotate(7deg)
}

.map-point{
position:absolute;
width:42px;
height:42px;
display:flex;
align-items:center;
justify-content:center;
border-radius:50%;
background:var(--red);
border:3px solid #080808;
font-size:18px
}

.point1{left:18%;top:23%}
.point2{left:65%;top:25%}
.point3{left:29%;top:67%}
.point4{left:73%;top:69%}
.point5{left:46%;top:45%}

/* DONATE */

.donate-banner{
padding:24px;
text-align:center;
background:
radial-gradient(circle,rgba(229,9,20,.18),transparent 65%),
#111;
border:1px solid #432020;
border-radius:14px
}

.donate-title{
font-size:29px;
font-weight:1000
}

.donate-title span{
color:var(--red)
}

.donate-sub{
color:#777;
font-size:11px;
margin-top:5px
}

.donate-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:9px;
margin-top:12px
}

.donate-card{
padding:17px;
text-align:center;
background:#111;
border:1px solid #292929;
border-radius:12px
}

.donate-card strong{
display:block;
color:var(--red);
font-size:20px
}

.donate-card span{
display:block;
color:#777;
font-size:10px;
margin:5px 0 10px
}

.donate-card button{
width:100%;
padding:9px;
background:var(--red);
color:#fff;
border-radius:7px;
font-size:10px;
font-weight:900
}

/* CHAT */

.chat-box{
overflow:hidden;
background:#0e0e0e;
border:1px solid #292929;
border-radius:13px
}

.chat-messages{
height:430px;
overflow-y:auto;
padding:12px
}

.message{
margin-bottom:10px
}

.message-name{
color:var(--red);
font-size:10px;
font-weight:900
}

.message-text{
display:inline-block;
margin-top:3px;
padding:8px 10px;
background:#1a1a1a;
border-radius:8px;
font-size:11px
}

.chat-input{
display:flex;
gap:7px;
padding:9px;
border-top:1px solid #292929
}

.chat-input input{
flex:1;
min-width:0;
padding:11px;
color:#fff;
background:#181818;
border:1px solid #292929;
border-radius:8px;
outline:none
}

.chat-input button{
width:48px;
background:var(--red);
color:#fff;
border-radius:8px
}

/* ONLINE */

.online-card{
display:flex;
align-items:center;
gap:11px;
padding:12px;
margin-bottom:7px;
background:#111;
border:1px solid #292929;
border-radius:11px
}

.avatar{
width:42px;
height:42px;
display:flex;
align-items:center;
justify-content:center;
background:#202020;
border-radius:50%;
border:1px solid #3a3a3a;
font-weight:900
}

.online-info{
flex:1
}

.online-name{
font-size:12px;
font-weight:900
}

.online-status{
color:var(--green);
font-size:9px;
margin-top:3px
}

.level{
padding:5px 7px;
background:#202020;
color:#bbb;
border-radius:6px;
font-size:9px
}

/* PROFILE */

.profile-head{
padding:20px;
text-align:center;
background:#111;
border:1px solid #292929;
border-radius:14px
}

.big-avatar{
width:82px;
height:82px;
display:flex;
align-items:center;
justify-content:center;
margin:auto;
border-radius:50%;
background:#202020;
border:2px solid var(--red);
font-size:30px;
font-weight:1000
}

.profile-name{
margin-top:10px;
font-size:21px;
font-weight:1000
}

.profile-id{
color:#777;
font-size:10px;
margin-top:4px
}

.profile-row{
display:flex;
justify-content:space-between;
padding:12px 0;
border-bottom:1px solid #292929;
font-size:12px
}

.profile-row:last-child{
border-bottom:0
}

.profile-row span:last-child{
color:#ccc
}

/* NAV */

.bottom-nav{
position:fixed;
bottom:0;
left:0;
right:0;
z-index:100;
height:68px;
display:flex;
justify-content:space-around;
background:#080808fa;
border-top:1px solid #292929;
backdrop-filter:blur(15px)
}

.nav-btn{
flex:1;
max-width:100px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:4px;
background:transparent;
color:#666;
font-size:9px;
font-weight:bold
}

.nav-icon{
font-size:19px
}

.nav-btn.active{
color:var(--red)
}

/* MODAL */

.modal{
position:fixed;
inset:0;
z-index:300;
display:flex;
align-items:flex-end;
justify-content:center;
padding:10px;
background:#000c
}

.modal-box{
width:100%;
max-width:500px;
max-height:85vh;
overflow:auto;
padding:20px;
background:#121212;
border:1px solid #363636;
border-radius:17px 17px 9px 9px
}

.close{
float:right;
width:30px;
height:30px;
color:#fff;
background:#292929;
border-radius:50%
}

.modal-title{
font-size:19px;
font-weight:900;
margin-bottom:8px
}

.modal-text{
color:#888;
font-size:11px;
line-height:1.5;
white-space:pre-line;
margin-bottom:15px
}

.toast{
position:fixed;
left:50%;
bottom:80px;
z-index:500;
transform:translateX(-50%) translateY(20px);
padding:11px 15px;
color:#fff;
background:#191919;
border:1px solid #383838;
border-radius:9px;
font-size:11px;
opacity:0;
pointer-events:none;
transition:.25s
}

.toast.show{
opacity:1;
transform:translateX(-50%) translateY(0)
}

/* RESPONSIVE */

@media(max-width:600px){

.cars-grid{
grid-template-columns:1fr
}

.dealer-image{
height:210px
}

.car-image{
height:190px
}

}

@media(min-width:700px){

.bottom-nav{
left:50%;
right:auto;
width:650px;
transform:translateX(-50%);
border:1px solid #292929;
border-bottom:0;
border-radius:13px 13px 0 0
}

.stats-grid{
grid-template-columns:repeat(4,1fr)
}

.quick-grid{
grid-template-columns:repeat(4,1fr)
}

.shop-grid,
.donate-grid{
grid-template-columns:repeat(4,1fr)
}

.cars-grid{
grid-template-columns:repeat(3,1fr)
}

}
</style>
</head>

<body>

<!-- AUTH -->

<section id="authScreen">

<div class="auth-box">

<div class="logo-box">
<div>
<div class="b">BR</div>
<div class="r">RP</div>
</div>
</div>

<div class="logo">BLACK <span>RUSSIA</span></div>
<div class="logo-sub">Role Play • Online World</div>

<div class="auth-tabs">
<button class="auth-tab active" id="loginTab" onclick="switchAuth('login')">
Вход
</button>

<button class="auth-tab" id="registerTab" onclick="switchAuth('register')">
Регистрация
</button>
</div>

<div id="loginForm">

<div class="auth-title">С возвращением</div>

<div class="auth-desc">
Введи логин и пароль своего игрового аккаунта.
</div>

<div class="field">
<label>ЛОГИН</label>
<input
id="loginUsername"
autocomplete="username"
placeholder="Введите логин">
</div>

<div class="field">
<label>ПАРОЛЬ</label>
<input
id="loginPassword"
type="password"
autocomplete="current-password"
placeholder="Введите пароль">
</div>

<button class="primary-btn" onclick="loginAccount()">
ВОЙТИ В ИГРУ
</button>

<div class="auth-message" id="loginMessage"></div>

</div>

<div id="registerForm" class="hidden">

<div class="auth-title">Новый аккаунт</div>

<div class="auth-desc">
Создай игровой аккаунт и получи собственный профиль.
</div>

<div class="field">
<label>ИГРОВОЙ ЛОГИН</label>
<input
id="regUsername"
autocomplete="username"
placeholder="Игровой ник">
</div>

<div class="field">
<label>ПОЧТА</label>
<input
id="regEmail"
type="email"
autocomplete="email"
placeholder="example@mail.com">
</div>

<div class="field">
<label>ПАРОЛЬ</label>
<input
id="regPassword"
type="password"
autocomplete="new-password"
placeholder="Минимум 6 символов">
</div>

<button class="primary-btn" onclick="registerAccount()">
СОЗДАТЬ АККАУНТ
</button>

<div class="auth-message" id="registerMessage"></div>

</div>

</div>
</section>


<!-- APP -->

<section id="app" class="hidden">

<header class="topbar">

<div class="top-logo">
BLACK <span>RUSSIA</span>
</div>

<div class="server-status">
<div class="online-dot"></div>
<span id="onlineCount">0 онлайн</span>
</div>

<div class="money-box">
<div class="money cash" id="topCash">₽ 0</div>
<div class="money donate" id="topDonate">♦ 0</div>
</div>

</header>


<!-- HOME -->

<main id="homePage" class="page active">

<div class="hero">

<div class="hero-small">
ДОБРО ПОЖАЛОВАТЬ НА СЕРВЕР
</div>

<div class="hero-name">
<span id="homeName">Player</span>
</div>

<div class="hero-small">
ТВОЯ ИСТОРИЯ НАЧИНАЕТСЯ ЗДЕСЬ
</div>

</div>

<div class="stats-grid">

<div class="stat-card">
<div class="stat-label">УРОВЕНЬ</div>
<div class="stat-value" id="homeLevel">1</div>
<div class="progress">
<div id="homeXpBar"></div>
</div>
</div>

<div class="stat-card">
<div class="stat-label">ОПЫТ</div>
<div class="stat-value" id="homeXP">0 XP</div>
</div>

<div class="stat-card">
<div class="stat-label">НАЛИЧНЫЕ</div>
<div class="stat-value" id="homeCash">₽ 0</div>
</div>

<div class="stat-card">
<div class="stat-label">БАНК</div>
<div class="stat-value" id="homeBank">₽ 0</div>
</div>

</div>

<div class="section-title">
Быстрый доступ
</div>

<div class="quick-grid">

<button class="quick" onclick="location.href='jobs.html'">
<div class="quick-icon">💼</div>
<div class="quick-name">Работы</div>
</button>

