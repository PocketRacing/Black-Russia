<script>

/* SUPABASE */

const SUPABASE_URL="https://qzswnoeglovfpgrzpnio.supabase.co";

const SUPABASE_KEY="sb_publishable_k_mSqLmEL-OMvM5x7slx7w_EqR0HXqY";

let currentUser=null;
let currentAuthUser=null;
let toastTimer=null;


/* FETCH */

async function supabaseFetch(path,options={}){

const r=await fetch(
SUPABASE_URL+path,
{
...options,
headers:{
apikey:SUPABASE_KEY,
Authorization:"Bearer "+SUPABASE_KEY,
"Content-Type":"application/json",
...(options.headers||{})
}
}
);

const t=await r.text();

let d=null;

try{
d=t?JSON.parse(t):null
}catch(e){
d=t
}

if(!r.ok)
throw new Error(
typeof d==="string"
?d
:JSON.stringify(d)
);

return d;
}


/* REGISTER */

async function registerAccount(){

const username=
document.getElementById("regUsername").value.trim();

const email=
document.getElementById("regEmail").value.trim();

const password=
document.getElementById("regPassword").value;

const message=
document.getElementById("registerMessage");

message.style.color="#ff4b55";
message.textContent="Создаём аккаунт...";

if(username.length<3)
return message.textContent=
"Логин минимум 3 символа.";

if(!/^[a-zA-Z0-9_]+$/.test(username))
return message.textContent=
"Только латиница, цифры и _.";

if(!email.includes("@"))
return message.textContent=
"Введите настоящую почту.";

if(password.length<6)
return message.textContent=
"Пароль минимум 6 символов.";

try{

const e=await supabaseFetch(
"/rest/v1/profiles?select=id&username=ilike."+
encodeURIComponent(username)+
"&limit=1"
);

if(e?.length)
return message.textContent=
"Такой логин уже занят.";

const r=await supabaseFetch(
"/auth/v1/signup",
{
method:"POST",
body:JSON.stringify({
email,
password,
data:{username}
})
}
);

if(r?.access_token){

saveSession(
r.access_token,
r.refresh_token
);

message.style.color="var(--green)";
message.textContent="Аккаунт создан!";

return loadSession();

}

message.style.color="#ffc928";
message.textContent=
"Аккаунт создан. Проверь почту.";

}catch(e){

console.error(e);

message.textContent=
"Ошибка: "+cleanError(e.message);

}

}


/* LOGIN */

async function loginAccount(){

const username=
document.getElementById("loginUsername").value.trim();

const password=
document.getElementById("loginPassword").value;

const message=
document.getElementById("loginMessage");

if(!username||!password)
return message.textContent=
"Введите логин и пароль.";

message.textContent=
"Выполняется вход...";

try{

const r=await supabaseFetch(
"/rest/v1/rpc/get_login_email",
{
method:"POST",
body:JSON.stringify({
p_username:username
})
}
);

if(!r)
return message.textContent=
"Аккаунт не найден.";

const email=
typeof r==="string"
?r
:r.email;

const a=await supabaseFetch(
"/auth/v1/token?grant_type=password",
{
method:"POST",
body:JSON.stringify({
email,
password
})
}
);

if(!a.access_token)
return message.textContent=
"Не удалось выполнить вход.";

saveSession(
a.access_token,
a.refresh_token
);

message.style.color="var(--green)";
message.textContent="Вход выполнен.";

await loadSession();

}catch(e){

console.error(e);

message.textContent=
"Ошибка: "+cleanError(e.message);

}

}


/* SESSION */

function saveSession(a,r){

localStorage.setItem(
"brp_access_token",
a||""
);

localStorage.setItem(
"brp_refresh_token",
r||""
);

}

function clearSession(){

localStorage.removeItem(
"brp_access_token"
);

localStorage.removeItem(
"brp_refresh_token"
);

}


/* LOAD SESSION */

async function loadSession(){

const token=
localStorage.getItem("brp_access_token");

if(!token)
return showAuth();

try{

currentAuthUser=
await supabaseFetch(
"/auth/v1/user",
{
headers:{
apikey:SUPABASE_KEY,
Authorization:"Bearer "+token
}
}
);

await loadProfile();

showApp();

}catch(e){

console.error(e);

clearSession();

showAuth();

}

}


/* PROFILE */

async function loadProfile(){

const token=
localStorage.getItem("brp_access_token");

const rows=
await supabaseFetch(
"/rest/v1/profiles?id=eq."+
encodeURIComponent(currentAuthUser.id)+
"&select=*",
{
headers:{
apikey:SUPABASE_KEY,
Authorization:"Bearer "+token
}
}
);

if(!rows?.length)
throw new Error(
"Профиль игрока не найден."
);

currentUser=rows[0];

renderAll();

}


/* AUTH UI */

function showAuth(){

document
.getElementById("authScreen")
.classList.remove("hidden");

document
.getElementById("app")
.classList.add("hidden");

}

function showApp(){

document
.getElementById("authScreen")
.classList.add("hidden");

document
.getElementById("app")
.classList.remove("hidden");

}

function switchAuth(type){

const login=type==="login";

document
.getElementById("loginForm")
.classList
.toggle("hidden",!login);

document
.getElementById("registerForm")
.classList
.toggle("hidden",login);

document
.getElementById("loginTab")
.classList
.toggle("active",login);

document
.getElementById("registerTab")
.classList
.toggle("active",!login);

}


