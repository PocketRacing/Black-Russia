set(
"profileId",
"ID: "+p.id
);

set("profileLevel",p.level);
set("profileXP",p.xp+" XP");
set("profileCash",money(p.cash));
set("profileBank",money(p.bank));
set(
"profileDonate",
"♦ "+number(p.donate)
