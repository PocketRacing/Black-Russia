/* CHAT */

async function loadChat(){

try{

const messages=
await supabaseFetch(
"/rest/v1/chat_messages?select=*&order=created_at.asc&limit=100",
{
headers:{
apikey:SUPABASE_KEY,
Authorization:
"Bearer "+
localStorage.getItem(
"brp_access_token"
)
}
}
)||[];

renderChat(messages);

}catch(e){

console.error(e);

renderChat([]);

}

}


function renderChat(messages){

const b=
document.getElementById(
"chatMessages"
);

if(!b)
return;

b.innerHTML="";


if(!messages.length){

b.innerHTML=`

<div class="message">

<div class="message-name">
SERVER
</div>

<div class="message-text">
Добро пожаловать в общий чат!
</div>

</div>
`;

return;

}


messages.forEach(m=>{

const d=
document.createElement("div");

d.className="message";

d.innerHTML=`

<div class="message-name">
${escapeHTML(
m.username||"Player"
)}
</div>

<div class="message-text">
${escapeHTML(
m.message||""
)}
</div>

`;

b.appendChild(d);

});

b.scrollTop=b.scrollHeight;

}


async function sendChat(){

const i=
document.getElementById(
"chatInput"
);

const text=
i.value.trim();

if(!text||text.length>150)
return;

try{

await supabaseFetch(
"/rest/v1/chat_messages",
{
method:"POST",

headers:{
apikey:SUPABASE_KEY,
Authorization:
"Bearer "+
localStorage.getItem(
"brp_access_token"
),
Prefer:"return=minimal"
},

body:JSON.stringify({

username:
currentUser.username,

message:text

})

}
);

i.value="";

await loadChat();

}catch(e){

console.error(e);

toast(
"❌ Не удалось отправить."
);

