function garageStorageKey(){

if(!currentAuthUser)
return "brp_garage_guest";

return "brp_garage_"+currentAuthUser.id;

}


function getOwnedCars(){

try{

return JSON.parse(
localStorage.getItem(
garageStorageKey()
)
)||[];

}catch(e){

return [];

}

}


function saveOwnedCars(cars){

localStorage.setItem(
garageStorageKey(),
JSON.stringify(cars)
);

}


